{
  "name": "ngcp-rest-api",
  "version": "0.0.1",
  "description": "REST API for the NGCP platform",
  "productName": "NGCP REST API",
  "author": "Sipwise Development Team <support@sipwise.com>",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=26 < 27",
    "yarn": ">=1.22.22"
  },
  "engineStrict": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "yarnpkg lint && nest build",
    "build:prod": "rimraf prod && webpack && node scripts/bytecompile.js",
    "build:dev-prod": "rimraf prod && NODE_ENV=development webpack",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "rimraf dist && NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "node prod/server",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --detectOpenHandles --forceExit --config jest-unit.config.js",
    "test:watch": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config jest-unit.config.js --watch",
    "test:cov": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config jest-unit.config.js --coverage",
    "test:debug": "node --experimental-vm-modules --config jest-unit.config.js --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --forceExit --config jest-e2e.config.js",
    "test:e2e:watch": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config jest-e2e.config.js --watch",
    "test:e2e:cov": "jest --clearCache && NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config jest-e2e.config.js --coverage",
    "test:e2e:debug": "node --experimental-vm-modules --config jest-e2e.config.js --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
